{
  "name": "esp-pinout-explorer",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:with-api": "npm run generate:board-api && npm run build",
    "typecheck": "vue-tsc --noEmit",
    "generate:board-api": "node scripts/generate-board-api.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/vue": "^1.77.0",
    "@mdi/js": "^7.4.47",
    "pinia": "^4.1.0",
    "roboto-fontface": "^0.10.0",
    "vue": "^3.5.46",
    "vuetify": "^4.3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
